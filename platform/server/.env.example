PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/foodwatch

# JWT – generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET
JWT_EXPIRES_IN=7d

# CORS origin (React dev server)
CLIENT_ORIGIN=http://localhost:3000

# Email (Nodemailer – use Gmail App Password or any SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="FoodWatch <your@gmail.com>"

# SMS – plug in your MSG91 / Twilio / Fast2SMS key here
SMS_API_KEY=REPLACE_WITH_YOUR_SMS_KEY
SMS_PROVIDER=msg91        # msg91 | twilio | fast2sms

# Optional: Google Maps API key (for geocoding)
GOOGLE_MAPS_KEY=REPLACE_WITH_GOOGLE_MAPS_API_KEY

# Upload directory (relative to server root)
UPLOAD_DIR=uploads
